# Local development only. Put real values in ignored .env or Railway Variables.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
BETTER_AUTH_URL=http://localhost:3000
# Generate privately: openssl rand -base64 32
BETTER_AUTH_SECRET=
PORT=3000
HOST=0.0.0.0
# Integration tests require a dedicated empty test database; never production.
# TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/toolhub_test
# Initial admin bootstrap only; remove these after the first successful startup.
# Set privately in Railway, never in Git.
# ADMIN_EMAIL=minhwuan889@gmail.com
# ADMIN_PASSWORD=
# ADMIN_NAME=Admin
# ADMIN_DEPARTMENT=Account

# Optional Railway usage connection. Keep token backend-only.
# Use a workspace-scoped API token, not a project deployment token.
# RAILWAY_API_TOKEN=
# RAILWAY_USAGE_WORKSPACE_ID=
